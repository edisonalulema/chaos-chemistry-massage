---
const links = [
  { href: '/', label: 'Home', title: 'Chaos & Chemistry — home' },
  { href: '/services', label: 'Services', title: 'Massage services in Granby and Winter Park' },
  { href: '/locations/granby', label: 'Granby', title: 'Massage therapy in Granby, CO' },
  { href: '/locations/winter-park', label: 'Winter Park', title: 'Deep tissue massage in Winter Park, CO' },
  { href: '/about', label: 'About', title: 'About Sarah, licensed massage therapist' },
  { href: '/contact', label: 'Contact', title: 'Contact Chaos & Chemistry Massage' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-sage-200 bg-sage-50/90 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
    <a href="/" class="font-display text-xl sm:text-2xl text-sage-800 leading-tight">
      Chaos &amp; Chemistry
      <span class="block text-xs tracking-widest uppercase text-sage-600 font-body">
        Massage and Bodywork
      </span>
    </a>
    <nav aria-label="Primary">
      <button
        id="nav-toggle"
        type="button"
        class="md:hidden text-sage-800 p-2"
        aria-expanded="false"
        aria-controls="nav-list"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
      <ul
        id="nav-list"
        class="hidden md:flex gap-6 text-sm absolute md:static top-full left-0 right-0 bg-sage-50 md:bg-transparent border-b md:border-b-0 border-sage-200 flex-col md:flex-row p-6 md:p-0"
      >
        {links.map(({ href, label, title }) => {
          const isActive = current === href.replace(/\/$/, '');
          return (
            <li>
              <a
                href={href}
                title={title}
                class:list={[
                  'text-sage-700 hover:text-sage-900 transition-colors',
                  isActive && 'text-sage-900 font-medium',
                ]}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const list = document.getElementById('nav-list');
  toggle?.addEventListener('click', () => {
    const open = list?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
