---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Chaos & Chemistry Massage | Granby & Winter Park, CO"
  description="Questions about a massage session in Grand County, Colorado? Email chaos.chemistry.massage@gmail.com or call our Granby or Winter Park locations."
>
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-sage-600 uppercase tracking-[0.2em] text-xs mb-3">Contact</p>
      <h1 class="font-display text-4xl md:text-5xl text-sage-900 mb-6">Get in Touch</h1>
      <p class="text-lg text-sage-800 leading-relaxed mb-10">
        Have a question about a specific modality, what to expect during your first session,
        or a request that isn't on the schedule? Reach out — I'd love to hear from you.
      </p>

      <a
        href="mailto:chaos.chemistry.massage@gmail.com"
        class="inline-block bg-sage-800 hover:bg-sage-900 text-white px-8 py-4 rounded-full text-base font-medium transition-colors"
      >
        chaos.chemistry.massage@gmail.com
      </a>
    </div>
  </section>

  <section class="bg-sage-100 py-16">
    <div class="max-w-5xl mx-auto px-6 grid md:grid-cols-2 gap-8">
      <div class="bg-white border border-sage-200 rounded-2xl p-8">
        <h2 class="font-display text-2xl text-sage-900 mb-3">Granby</h2>
        <p class="text-sage-600 text-sm mb-4">Mana Acupuncture</p>
        <address class="not-italic text-sage-800 leading-relaxed mb-6">
          55 1st St Unit A<br />
          Granby, CO 80446
        </address>
        <p class="text-sage-800 mb-4">
          <a href="tel:+19702813022" class="text-sage-700 hover:text-sage-900 underline font-medium">
            (970) 281-3022
          </a>
        </p>
        <a
          href="/locations/granby"
          class="inline-block text-sm border border-sage-700 text-sage-800 hover:bg-sage-700 hover:text-white px-4 py-2 rounded-full transition-colors"
        >
          Hours &amp; booking →
        </a>
      </div>

      <div class="bg-white border border-sage-200 rounded-2xl p-8">
        <h2 class="font-display text-2xl text-sage-900 mb-3">Winter Park</h2>
        <p class="text-sage-600 text-sm mb-4">Blue Sky Massage</p>
        <address class="not-italic text-sage-800 leading-relaxed mb-6">
          21 Telemark Dr Unit 201<br />
          Winter Park, CO 80482
        </address>
        <p class="text-sage-800 mb-4">
          <a href="tel:+19705311324" class="text-sage-700 hover:text-sage-900 underline font-medium">
            (970) 531-1324
          </a>
        </p>
        <a
          href="/locations/winter-park"
          class="inline-block text-sm border border-sage-700 text-sage-800 hover:bg-sage-700 hover:text-white px-4 py-2 rounded-full transition-colors"
        >
          Hours &amp; booking →
        </a>
      </div>
    </div>
  </section>
</Layout>
