---
import Layout from '../layouts/Layout.astro';

const techniques = [
  {
    name: 'Swedish',
    note: 'Long, flowing strokes that calm the nervous system and warm tissue before deeper work.',
  },
  {
    name: 'Deep Tissue',
    note: 'Slower, more focused pressure for chronic tension, postural strain, and athletic recovery.',
  },
  {
    name: 'Myofascial Release',
    note: 'Sustained, gentle pressure into the fascia to release restrictions that limit movement.',
  },
  {
    name: 'Trigger Point',
    note: 'Precise pressure on points that refer pain elsewhere — tension headaches, jaw, shoulders, hips.',
  },
  {
    name: 'Cupping',
    note: 'Silicone cups create gentle suction that lifts fascia and decompresses tight tissue.',
  },
];
---

<Layout
  title="My Approach to Bodywork | Granby & Winter Park Massage"
  description="An integrated approach to massage and bodywork in Grand County, Colorado. Each session blends Swedish, deep tissue, myofascial release, trigger point, and cupping techniques."
>
  <section class="bg-sage-100 py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-sage-600 uppercase tracking-[0.2em] text-xs mb-4">My Approach</p>
      <h1 class="font-display text-4xl md:text-5xl text-sage-900 mb-6">
        One Session. Many Techniques.
      </h1>
      <p class="text-lg text-sage-800 leading-relaxed">
        I don't offer modalities as separate services. Every session is integrated —
        I weave techniques together based on what your body is asking for that day.
        You don't pick from a menu. You show up, we talk, and the session unfolds.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-3xl text-sage-900 mb-6 text-center">
        How a Session Flows
      </h2>
      <div class="space-y-6 text-lg text-sage-800 leading-relaxed">
        <p>
          We start with a brief check-in — what's been going on in your body this week,
          where you're holding tension, what you're hoping to move through. From there,
          I build the session around what I'm feeling in your tissue.
        </p>
        <p>
          A typical session might open with long Swedish strokes to warm everything up,
          shift into focused deep tissue or myofascial work where you need it, weave in
          trigger point release for stubborn knots, and finish with cupping or
          breath-led integration to settle the nervous system.
        </p>
        <p>
          You'll never be asked to choose a single technique. Your body changes from
          session to session — so does mine.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-sage-50 py-16 md:py-20 border-y border-sage-200">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-sage-600 uppercase tracking-[0.2em] text-xs mb-3">What I Bring</p>
        <h2 class="font-display text-3xl md:text-4xl text-sage-900 mb-4">
          Techniques Woven Into Every Session
        </h2>
        <p class="text-sage-700 max-w-2xl mx-auto">
          The training and tools I draw from. None of these are standalone services —
          they're the vocabulary I use to respond to what your body needs.
        </p>
      </div>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {techniques.map((t) => (
          <li class="bg-white border border-sage-200 rounded-2xl p-6">
            <h3 class="font-display text-xl text-sage-900 mb-2">{t.name}</h3>
            <p class="text-sm text-sage-700 leading-relaxed">{t.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-sage-800 text-sage-50 py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-4xl mb-4">Ready to book?</h2>
      <p class="text-sage-200 mb-8">
        Choose the location that works best for you.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="/locations/granby"
          class="bg-sage-50 text-sage-900 hover:bg-white px-6 py-3 rounded-full text-sm font-medium transition-colors"
        >
          Book in Granby
        </a>
        <a
          href="/locations/winter-park"
          class="bg-clay-400 text-sage-900 hover:bg-clay-200 px-6 py-3 rounded-full text-sm font-medium transition-colors"
        >
          Book in Winter Park
        </a>
      </div>
    </div>
  </section>
</Layout>
